+/** Scope cancellation to UI still awaited by this tool call, not completed non-blocking launches. */
+function abortableToolContext(ctx: ExtensionContext, signal?: AbortSignal): { ctx: ExtensionContext; dispose(): void } {
+	if (!signal) return { ctx, dispose() {} };
+	const cancellations = new Set<() => void>();
+	const aborted = () => { for (const cancel of [...cancellations]) cancel(); };
+	signal.addEventListener("abort", aborted, { once: true });
+	const ui = Object.create(ctx.ui) as ExtensionUIContext;
+	ui.confirm = (title, message, options) => ctx.ui.confirm(title, message, { ...options, signal });
+	ui.select = (title, items, options) => ctx.ui.select(title, items, { ...options, signal });
+	ui.custom = ((factory, options) => ctx.ui.custom((tui, theme, keys, done) => {
+		signal.throwIfAborted();
+		let closed = false;
+		let cancel: (() => void) | undefined;
+		const complete = (result: Parameters<typeof done>[0]) => {
+			if (closed) return;
+			closed = true;
+			if (cancel) cancellations.delete(cancel);
+			done(result);
+		};
+		const register = (component: Awaited<ReturnType<typeof factory>>) => {
+			cancel = () => {
+				if (closed) return;
+				const shell = component as typeof component & { killSession?: () => void };
+				try {
+					if (typeof shell.killSession === "function") shell.killSession();
+					else complete({ exitCode: null, backgrounded: false, cancelled: true } as Parameters<typeof done>[0]);
+				} catch { complete({ exitCode: null, backgrounded: false, cancelled: true } as Parameters<typeof done>[0]); }
+			};
+			if (!closed) cancellations.add(cancel);
+			if (signal.aborted) cancel();
+			return component;
+		};
+		const component = factory(tui, theme, keys, complete);
+		return component instanceof Promise ? component.then(register) : register(component);
+	}, options)) as ExtensionUIContext["custom"];
+	const scoped = Object.create(ctx) as ExtensionContext;
+	Object.defineProperty(scoped, "ui", { value: ui });
+	return { ctx: scoped, dispose() { signal.removeEventListener("abort", aborted); cancellations.clear(); } };
+}
